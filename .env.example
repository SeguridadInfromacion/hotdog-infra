# Ejemplo de configuración. El archivo real (.env) lo genera el paso de setup
# con valores aleatorios:
#   docker compose -f docker-compose.setup.yml run --rm setup

# Dirección y puertos donde escucha el gateway en tu máquina.
BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
HTTP_PORT=8080

# Una contraseña de superusuario y una de aplicación por cada base.
AUTH_DB_ROOT_PASSWORD=cambia-esto
AUTH_DB_PASSWORD=cambia-esto
PRODUCTS_DB_ROOT_PASSWORD=cambia-esto
PRODUCTS_DB_PASSWORD=cambia-esto
ORDERS_DB_ROOT_PASSWORD=cambia-esto
ORDERS_DB_PASSWORD=cambia-esto

# Usuarios iniciales (mínimo 10 caracteres, con letras y números).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto-123
DEMO_CASHIER_USERNAME=cajero
DEMO_CASHIER_PASSWORD=cambia-esto-123
